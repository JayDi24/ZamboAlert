PORT=3000
GATEWAY_API_KEY=replace-with-a-long-random-shared-key
GMAIL_USER=your-sender@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# New barangay official (web dashboard) accounts start unapproved and cannot sign in
# until an administrator approves them:
#   GET  /api/admin/officials               (list, shows official_approved)
#   POST /api/admin/officials/:id/approve   (header X-Admin-Key: <ADMIN_API_KEY>)
#   POST /api/admin/officials/:id/reject    (removes a not-yet-approved registration)
# ADMIN_API_KEY=replace-with-a-long-random-admin-key
