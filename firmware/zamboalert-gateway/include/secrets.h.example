#pragma once
// Copy to secrets.h (gitignored) and fill in real values.
#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"
// Must equal GATEWAY_API_KEY in backend/.env (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
#define GATEWAY_API_KEY "replace-with-long-random-key"

// Backend telemetry endpoint: your PC LAN IP (ipconfig) or the Render URL
#define SERVER_URL    "http://YOUR-PC-IP:3000/api/telemetry"

// Gateway's real, fixed location (where it is installed). Kept here, not in
// config.h, so a home address never ends up in git. Leave both out to use
// the placeholder in config.h (the web map then labels it "location not set").
// #define GATEWAY_LAT 6.9xxxxx
// #define GATEWAY_LNG 122.xxxxxx
